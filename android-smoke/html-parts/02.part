orientationLabel = document.getElementById('orientationLabel');
    const hint = document.getElementById('hint');
    const errorBox = document.getElementById('errorBox');
    const modelStatus = document.getElementById('modelStatus');
    const IS_ANDROID_APP = window.__ANDROID_APP__ === true;
    const ANDROID_SAFE_MODE = window.__ANDROID_SAFE_MODE__ === true;

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x07101d, 16, 31);

    const camera = new THREE.PerspectiveCamera(39, 1, 0.1, 100);
    camera.position.set(0, 1.3, -20);

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({
        antialias: !IS_ANDROID_APP,
        alpha: true,
        powerPreference: IS_ANDROID_APP ? 'default' : 'high-performance'
      });
    } catch (error) {
      showFatalError('WebGLを開始できませんでした。WebGL対応ブラウザで開いてください。', error);
      throw error;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, IS_ANDROID_APP ? 1.25 : 2));
    renderer.setSize(canvasHost.clientWidth, canvasHost.clientHeight);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;
    renderer.shadowMap.enabled = !IS_ANDROID_APP;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    canvasHost.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.075;
    controls.target.set(0, 1.15, 0.25);
    controls.minDistance = 9;
    controls.maxDistance = 31;
    controls.enablePan = true;
    controls.screenSpacePanning = true;
    controls.maxPolarAngle = Math.PI * 0.98;

    scene.add(new THREE.HemisphereLight(0xd7efff, 0x263547, 1.8));
    const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
    keyLight.position.set(-5, 8, -8);
    keyLight.castShadow = true;
    scene.add(keyLight);
    const fillLight = new THREE.DirectionalLight(0x80cfff, 1.35);
    fillLight.position.set(7, 2, 7);
    scene.add(fillLight);
    const rimLight = new THREE.DirectionalLight(0xffddb0, 1.25);
    rimLight.position.set(-6, 0, 8);
    scene.add(rimLight);

    const floor = new THREE.Mesh(
      new THREE.CircleGeometry(8.8, 72),
      new THREE.MeshStandardMaterial({ color: 0x0c1725, roughness: 0.9, metalness: 0.05, transparent: true, opacity: 0.8 })
    );
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -5.45;
    floor.receiveShadow = true;
    scene.add(floor);

    const grid = new THREE.GridHelper(15, 30, 0x1b6b88, 0x1a3044);
    grid.position.y = -5.42;
    grid.material.opacity = 0.28;
    grid.material.transparent = true;
    scene.add(grid);

    const boneRegistry = new Map();
    const selectableMeshes = [];
    const baseColor = new THREE.Color(0xeadfca);
    const selectedColor = new THREE.Color(0xf59e0b);
    const markedColor = new THREE.Color(0xfb7185);
    let selectedBoneId = null;
    let backFocusEnabled = false;

    const saved = loadSavedState();

    function boneMaterial() {
      return new THREE.MeshStandardMaterial({
        color: baseColor,
        roughness: 0.62,
        metalness: 0.02,
        emissive: 0x000000,
        transparent: true,
        opacity: 1,
        side: THREE.DoubleSide
      });
    }

    function registerBoneMetadata(id, name, code, category, description, options = {}) {
      if (boneRegistry.has(id)) return boneRegistry.get(id);
      const record = { id, name, code, category, description, meshes: [], options };
      boneRegistry.set(id, record);
      return record;
    }

    // 表示形状はAPK内蔵のBodyParts3D GLBだけを使用する。
    // ここでは選択UIに必要な名称・部位説明だけを登録し、近似骨格は生成しない。
    registerBoneMetadata('skull', '頭蓋骨', 'SKULL', '頭部', '前頭骨・頭頂骨・側頭骨・後頭骨・顔面骨・下顎骨などをまとめた頭部骨格です。');

    const cervicalNames = ['環椎', '軸椎'];
    for (let i = 1; i <= 7; i++) {
      const special = cervicalNames[i - 1];
      registerBoneMetadata(
        `C${i}`,
        special ? `${special}（第${i}頸椎）` : `第${i}頸椎`,
        `C${i}`,
        '頸椎',
        i === 1 ? '頭蓋骨を支える最上位の頸椎で、輪状の形態が特徴です。' :
        i === 2 ? '歯突起を持ち、頭部の回旋運動に重要な頸椎です。' :
        `頸椎7個のうち上から${i}番目の椎骨です。`,
        { backStructure: true }
      );
    }

    for (let i = 1; i <= 12; i++) {
      registerBoneMetadata(
        `T${i}`, `第${i}胸椎`, `T${i}`, '胸椎',
        `胸郭の後方に並ぶ12個の椎骨のうち上から${i}番目です。肋骨と関節します。`,
        { backStructure: true }
      );
    }

    for (let i = 1; i <= 5; i++) {
      registerBoneMetadata(
        `L${i}`, `第${i}腰椎`, `L${i}`, '腰椎',
        `腰を構成する5個の大きな椎骨のうち上から${i}番目です。上半身の荷重を支えます。`,
        { backStructure: true }
      );
    }

    registerBoneMetadata('sacrum', '仙骨', 'SACRUM', '骨盤・脊柱', '腰椎の下で左右の寛骨をつなぎ、骨盤輪の後壁をつくる骨です。', { backStructure: true });

    for (let n = 1; n <= 12; n++) {
      for (const sideName of ['右', '左']) {
        registerBoneMetadata(
          `rib-${n}-${sideName}`, `第${n}肋骨（${sideName}）`, `RIB ${n} ${sideName}`, '肋骨',
          n <= 7 ? '胸椎から胸骨側へ連続する真肋です。' :
          n <= 10 ? '肋軟骨を介して肋骨弓へ連続する仮肋です。' :
          '前方が胸骨へ直接つながらない浮遊肋です。',
          { frontStructure: true }
        );
      }
    }

    registerBoneMetadata('sternum', '胸骨', 'STERNUM', '胸郭', '胸骨柄・胸骨体・剣状突起からなる胸郭前面の扁平骨です。', { frontStructure: true });

    for (const sideName of ['右', '左']) {
      registerBoneMetadata(`clavicle-${sideName}`, `鎖骨（${sideName}）`, `CLAVICLE ${sideName}`, '肩帯', '胸骨と肩甲骨をつなぐS字状の長骨です。', { frontStructure: true });
      registerBoneMetadata(`scapula-${sideName}`, `肩甲骨（${sideName}）`, `SCAPULA ${sideName}`, '肩帯・背部', '肩甲棘・肩峰・烏口突起・関節窩を持つ背部の扁平骨です。', { backStructure: true });
      registerBoneMetadata(`pelvis-${sideName}`, `寛骨（${sideName}）`, `PELVIS ${sideName}`, '骨盤', '腸骨・坐骨・恥骨が癒合して構成され、寛骨臼を形成する骨です。', { backStructure: true });
      registerBoneMetadata(`humerus-${sideName}`, `上腕骨（${sideName}）`, `HUMERUS ${sideName}`, '上肢', '肩甲骨の関節窩と肘関節をつなぐ上腕の長骨です。');
      registerBoneMetadata(`radius-${sideName}`, `橈骨（${sideName}）`, `RADIUS ${sideName}`, '前腕', '前腕の親指側にあり、手首側で幅広くなる長骨です。');
      registerBoneMetadata(`ulna-${sideName}`, `尺骨（${sideName}）`, `ULNA ${sideName}`, '前腕', '前腕の小指側にあり、近位端の肘頭が肘の突出をつくる長骨です。');
      registerBoneMetadata(`hand-${sideName}`, `手の骨（${sideName}）`, `HAND ${sideName}`, '手', '8個の手根骨、5本の中手骨、指骨をまとめた手部骨格です。');
    }

    // 下肢は高精細BodyParts3Dメッシュのみを使用し、簡易形状は生成しない。
    for (const [sideName, suffix] of [['右', '右'], ['左', '左']]) {
      registerBoneMetadata(`femur-${suffix}`, `大腿骨（${sideName}）`, `FEMUR ${sideName}`, '大腿', '骨盤の寛骨臼から膝まで伸びる人体最大の長骨です。近位端の骨頭・頸部と遠位端の内外側顆を含みます。');
      registerBoneMetadata(`patella-${suffix}`, `膝蓋骨（${sideName}）`, `PATELLA ${sideName}`, '膝', '膝関節前面の大腿四頭筋腱内にある種子骨です。膝関節を保護し、伸展機構を補助します。', { frontStructure: true });
      registerBoneMetadata(`tibia-${suffix}`, `脛骨（${sideName}）`, `TIBIA ${sideName}`, '下腿', '下腿内側にある太い長骨で、膝から足関節へ体重を伝えます。');
      registerBoneMetadata(`fibula-${suffix}`, `腓骨（${sideName}）`, `FIBULA ${sideName}`, '下腿', '下腿外側にある細長い骨です。外果をつくり、足関節の安定に関わります。');
      registerBoneMetadata(`foot-${suffix}`, `