    function centerOfObject(object) {
      const box = new THREE.Box3().setFromObject(object);
      return box.getCenter(new THREE.Vector3());
    }

    function updateModelStatus(text, state = '') {
      modelStatus.textContent = text;
      modelStatus.classList.remove('ready', 'fallback');
      if (state) modelStatus.classList.add(state);
    }

    function orientAndFitAnatomicalGroup(group) {
      group.updateMatrixWorld(true);
      let box = new THREE.Box3().setFromObject(group);
      const initialSize = box.getSize(new THREE.Vector3());
      const largestAxis = initialSize.x > initialSize.y && initialSize.x > initialSize.z ? 'x' : (initialSize.z > initialSize.y ? 'z' : 'y');
      if (largestAxis === 'z') group.rotation.x = -Math.PI / 2;
      else if (largestAxis === 'x') group.rotation.z = Math.PI / 2;
      group.updateMatrixWorld(true);

      // 胸骨を胸椎より前（+Z）に合わせ、正面・背面ボタンの意味を人体方向と一致させる。
      const sternumMesh = boneRegistry.get('sternum')?.meshes[0];
      const spineMeshes = ['T4', 'T6', 'T8', 'T10'].map(id => boneRegistry.get(id)?.meshes[0]).filter(Boolean);
      if (sternumMesh && spineMeshes.length) {
        cons