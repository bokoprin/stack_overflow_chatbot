足部の骨（${sideName}）`, `FOOT ${sideName}`, '足', '距骨・踵骨・舟状骨・楔状骨・立方骨、中足骨および足趾骨をまとめた足部骨格です。');
    }

    // 骨一覧をカテゴリ順に作成
    const categoryOrder = ['頭部','頸椎','胸椎','腰椎','骨盤・脊柱','胸郭','肋骨','肩帯','肩帯・背部','骨盤','上肢','前腕','手','大腿','膝','下腿','足'];
    const grouped = new Map();
    for (const bone of boneRegistry.values()) {
      if (!grouped.has(bone.category)) grouped.set(bone.category, []);
      grouped.get(bone.category).push(bone);
    }
    for (const category of categoryOrder) {
      const bones = grouped.get(category);
      if (!bones) continue;
      const optgroup = document.createElement('optgroup');
      optgroup.label = category;
      for (const bone of bones) {
        const option = document.createElement('option');
        option.value = bone.id;
        option.textContent = bone.code ? `${bone.name}［${bone.code}］` : bone.name;
        optgroup.appendChild(option);
      }
      boneSelect.appendChild(optgroup);
    }


